<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">

    <!-- Nút Bắt đầu ở giữa -->
    <Button android:id="@+id/btnStartAuto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="BẮT ĐẦU AUTO" android:backgroundTint="#FF5722" />

    <!-- Nút X thoát khẩn cấp ở góc trên bên phải -->
    <Button android:id="@+id/btnCloseOverlay" android:layout_width="50dp" android:layout_height="50dp" android:layout_gravity="top|end" android:layout_margin="20dp" android:text="X" android:textSize="18sp" android:textStyle="bold" android:backgroundTint="#D32F2F" />
</FrameLayout>
