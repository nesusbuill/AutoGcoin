<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center" android:orientation="vertical" android:padding="24dp">

    <Button android:id="@+id/btnAccessibility" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1. Cấp quyền Trợ năng" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Chọn Game từ danh sách:" android:textStyle="bold"/>
    
    <Spinner
        android:id="@+id/spinnerApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#FF5722"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Hoặc tự nhập Package Name:" android:textStyle="bold"/>
    
    <!-- Ô nhập tay Package Name -->
    <EditText
        android:id="@+id/edtPackage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ví dụ: com.hortor.juliancysj"
        android:inputType="text"
        android:layout_marginTop="8dp"/>

    <Button android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="2. Bắt đầu Cày Gcoin" android:backgroundTint="#4CAF50"/>
</LinearLayout>
